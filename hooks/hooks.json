{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_review_stop.py\"",
            "timeout": 1900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/qa-testing/scripts/ui_review_gate.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
